@{
    ViewData["Title"] = "Home Page";
}

<div class="home-page">

    <!-- Hero -->
    <div class="hero">
        <div class="hero__inner">
            <span class="hero__eyebrow">🌿 100% Local &amp; Organic</span>
            <h1>Fresh from the<br>Farm to Your Door</h1>
            <p>Discover seasonal produce from trusted local farmers. No middlemen — just honest food, fairly priced and delivered fresh.</p>
            <div class="actions">
                <a href="/Products" class="btn-primary">Browse Products</a>
                <a href="/Orders" class="btn-secondary">View My Orders</a>
            </div>
        </div>
    </div>

    <!-- Trust Strip -->
    <div class="trust-strip">
        <div class="trust-item">
            <span class="trust-item__icon">🚜</span>
            <span>Locally Sourced</span>
        </div>
        <div class="trust-item">
            <span class="trust-item__icon">🌱</span>
            <span>Certified Organic</span>
        </div>
        <div class="trust-item">
            <span class="trust-item__icon">📦</span>
            <span>Fresh Every Week</span>
        </div>
        <div class="trust-item">
            <span class="trust-item__icon">⭐</span>
            <span>Loyalty Rewards</span>
        </div>
        <div class="trust-item">
            <span class="trust-item__icon">🤝</span>
            <span>Support Local Farmers</span>
        </div>
    </div>

    <!-- Features Section -->
    <div class="home-section">
        <p class="section-label">Why Greenfield</p>
        <h2 class="section-title">A better way to buy local</h2>
        <p class="section-sub">We partner with family-run farms in your region to bring you produce that's picked at peak freshness — not shipped across the country.</p>
        <div class="feature-grid">
            <div class="feature-card">
                <span class="feature-card__icon">🥕</span>
                <h3>Seasonal Produce</h3>
                <p>We stock what's in season, meaning better flavour, higher nutrients, and lower environmental impact.</p>
            </div>
            <div class="feature-card">
                <span class="feature-card__icon">🏡</span>
                <h3>Know Your Farmer</h3>
                <p>Every product is linked to a verified local producer. See who grew your food before you buy.</p>
            </div>
            <div class="feature-card">
                <span class="feature-card__icon">🛒</span>
                <h3>Simple Ordering</h3>
                <p>Add items to your basket, choose collection or delivery, and manage everything from your account.</p>
            </div>
            <div class="feature-card">
                <span class="feature-card__icon">⭐</span>
                <h3>Earn Rewards</h3>
                <p>Every purchase earns loyalty points. Redeem them for discounts on future orders.</p>
            </div>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="home-section--alt">
        <p class="section-label">Our Community</p>
        <h2 class="section-title">Growing together</h2>
        <div class="stats-row">
            <div class="stat-item">
                <span class="stat-item__num">40+</span>
                <span class="stat-item__label">Local Producers</span>
            </div>
            <div class="stat-item">
                <span class="stat-item__num">200+</span>
                <span class="stat-item__label">Fresh Products</span>
            </div>
            <div class="stat-item">
                <span class="stat-item__num">3,500</span>
                <span class="stat-item__label">Happy Customers</span>
            </div>
            <div class="stat-item">
                <span class="stat-item__num">98%</span>
                <span class="stat-item__label">Satisfaction Rate</span>
            </div>
        </div>
    </div>

    <!-- CTA Banner -->
    <div class="cta-banner">
        <h2>Ready to eat better?</h2>
        <p>Join thousands of customers supporting local farms and enjoying fresher food every week.</p>
        <a href="/Products" class="cta-btn">Shop Now</a>
    </div>

</div>