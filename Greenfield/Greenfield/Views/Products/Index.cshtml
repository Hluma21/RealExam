@model IEnumerable<Greenfield.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<link rel="stylesheet" href="~/css/Products.css" asp-append-version="true" />

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ProductName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.stock)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsAvailable)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImagePath)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Producer)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Rating)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.stock)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsAvailable)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
               <img src="@item.ImagePath"/>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Producer.ProducerId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProductId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ProductId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ProductId">Delete</a>
                 <form asp-controller ="BasketProducts" asp-action="Create" method="post">
                        <input type="hidden" name="ProductId" value="@item.ProductId" />

                     @if (item.stock >0)
                     {
                         <button type="submit">
                             Add to basket
                         </button>
                     }
                     else
                     {
                         <button type="button" disabled>
                             Out of Stock
                         </button>
                     }
                 </form>
            </td>
        </tr>
}
    </tbody>
</table>
